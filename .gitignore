# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env*.local
mobile/.env
mobile/node_modules

# typescript
*.tsbuildinfo

# python
.venv/
__pycache__/

# video pipeline — footage, audio, frame dumps and renders
video-pipeline/work/
video-pipeline/.venv/
video-pipeline/public/input-video.mp4
video-pipeline/public/snapshots/
# Renders at the pipeline root. overlay.mov runs to several GB; GitHub hard-rejects
# anything over 100 MB, so these must never reach a commit.
video-pipeline/*.mov
video-pipeline/*.mp4

# Local scratch — one-off probes, drafts and per-student notes that are not
# part of the app and should not enter its history.
_*.mjs
bug-reply-*.md
nattida-writing-review.html

# hyperframes skills (installed via `npx skills add`)
.agents/

# Supabase CLI local cache (do not commit)
supabase/.temp/
.vercel

# local scratch (transcripts, ffmpeg, previews)
tmp/

# one-off audit/debug scripts kept locally, never part of the app
scratchpad-*.mjs
