{
  "expo": {
    "name": "English Plan",
    "slug": "english-plan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "englishplan",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.languageplanprep.app"
    },
    "android": {
      "package": "co.languageplanprep.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "English Plan uses the microphone to record your spoken answers in speaking practice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
